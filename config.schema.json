{
  "pluginAlias": "HomePodIsraelHebrew",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "הכרזות קוליות טבעיות בעברית בהום פוד | Natural-voice announcements on your HomePods. [מדריך](https://github.com/orenasher/homebridge-homepod-israel-hebrew/blob/main/README.he.md) · [Guide](https://github.com/orenasher/homebridge-homepod-israel-hebrew#readme)",
  "footerDisplay": "☕ [PayPal](https://paypal.me/orenasher)",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "שם | Name",
        "type": "string",
        "default": "HomePod Israel Hebrew"
      },
      "language": {
        "title": "שפת ההגדרות | Settings language",
        "type": "string",
        "default": "he",
        "oneOf": [
          {
            "title": "עברית",
            "enum": [
              "he"
            ]
          },
          {
            "title": "English",
            "enum": [
              "en"
            ]
          }
        ]
      },
      "speakers": {
        "title": "הום פודים | HomePods",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "שם | Name",
              "type": "string"
            },
            "host": {
              "title": "כתובת IP | IP address",
              "type": "string"
            },
            "id": {
              "title": "מזהה | Device ID",
              "type": "string"
            },
            "volume": {
              "title": "ווליום ברירת מחדל | Default volume",
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "phrases": {
        "title": "מה ההום פוד יגיד | Phrases",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "title": "טקסט | Text",
              "type": "string"
            },
            "name": {
              "title": "שם המתג | Switch name",
              "type": "string"
            },
            "speakers": {
              "title": "הום פודים (ריק = כולם) | HomePods (empty = all)",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "voice": {
              "title": "קול | Voice",
              "type": "string",
              "description": "hila, avri, gemini-puck, openai-onyx, cartesia:<id>, clone:<id> …"
            },
            "volume": {
              "title": "ווליום | Volume",
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "style": {
              "title": "סגנון | Style",
              "type": "string",
              "oneOf": [
                {
                  "title": "רגיל | Normal",
                  "enum": [
                    "normal"
                  ]
                },
                {
                  "title": "שמח ועליז | Cheerful",
                  "enum": [
                    "cheerful"
                  ]
                },
                {
                  "title": "רגוע ושקט | Calm & quiet",
                  "enum": [
                    "calm"
                  ]
                },
                {
                  "title": "לחישה | Whisper",
                  "enum": [
                    "whisper"
                  ]
                },
                {
                  "title": "כרוז רשמי | Announcer",
                  "enum": [
                    "announcer"
                  ]
                },
                {
                  "title": "דחוף / אזהרה | Urgent warning",
                  "enum": [
                    "urgent"
                  ]
                },
                {
                  "title": "חם ואוהב | Warm & loving",
                  "enum": [
                    "warm"
                  ]
                },
                {
                  "title": "נרגש ומלא אנרגיה | Excited",
                  "enum": [
                    "excited"
                  ]
                },
                {
                  "title": "מצחיק ושובב | Playful",
                  "enum": [
                    "funny"
                  ]
                }
              ]
            },
            "urgent": {
              "title": "דחוף | Urgent",
              "type": "boolean",
              "default": false,
              "description": "קופץ לראש התור, מושמע גם בשעות שקט | Jumps the queue and plays even during quiet hours"
            }
          },
          "required": [
            "text"
          ]
        }
      },
      "groupSwitches": {
        "title": "כל המתגים בקבוצה אחת | All switches in one group",
        "type": "boolean",
        "default": false,
        "description": "מציג את כל המשפטים כאביזר אחד בבית של אפל | Show all phrases as one accessory in Apple Home"
      },
      "groupName": {
        "title": "שם הקבוצה | Group name",
        "type": "string",
        "default": "קבצי הקול שלי"
      },
      "voice": {
        "title": "קול ברירת מחדל | Default voice",
        "type": "string",
        "default": "hila",
        "description": "hila, avri, gemini-puck, openai-onyx, cartesia:<id>, clone:<id> …"
      },
      "style": {
        "title": "סגנון ברירת מחדל | Default style",
        "type": "string",
        "default": "normal",
        "oneOf": [
          {
            "title": "רגיל | Normal",
            "enum": [
              "normal"
            ]
          },
          {
            "title": "שמח ועליז | Cheerful",
            "enum": [
              "cheerful"
            ]
          },
          {
            "title": "רגוע ושקט | Calm & quiet",
            "enum": [
              "calm"
            ]
          },
          {
            "title": "לחישה | Whisper",
            "enum": [
              "whisper"
            ]
          },
          {
            "title": "כרוז רשמי | Announcer",
            "enum": [
              "announcer"
            ]
          },
          {
            "title": "דחוף / אזהרה | Urgent warning",
            "enum": [
              "urgent"
            ]
          },
          {
            "title": "חם ואוהב | Warm & loving",
            "enum": [
              "warm"
            ]
          },
          {
            "title": "נרגש ומלא אנרגיה | Excited",
            "enum": [
              "excited"
            ]
          },
          {
            "title": "מצחיק ושובב | Playful",
            "enum": [
              "funny"
            ]
          }
        ]
      },
      "tts": {
        "title": "קולות פרימיום | Premium voices",
        "type": "object",
        "properties": {
          "geminiApiKey": {
            "title": "Gemini API key (free — aistudio.google.com/apikey)",
            "type": "string"
          },
          "geminiModel": {
            "title": "Gemini TTS model (advanced)",
            "type": "string",
            "placeholder": "gemini-3.1-flash-tts-preview"
          },
          "elevenlabsApiKey": {
            "title": "ElevenLabs API key",
            "type": "string"
          },
          "elevenlabsVoiceId": {
            "title": "ElevenLabs voice ID",
            "type": "string"
          },
          "elevenlabsModel": {
            "title": "ElevenLabs model",
            "type": "string",
            "default": "eleven_v3"
          },
          "elevenlabsLanguage": {
            "title": "ElevenLabs language",
            "type": "string",
            "default": "he"
          },
          "googleApiKey": {
            "title": "Google Cloud API key",
            "type": "string"
          },
          "fallback": {
            "title": "גיבוי לקול חינמי | Fall back to a free voice",
            "type": "boolean",
            "default": true
          },
          "openaiApiKey": {
            "title": "OpenAI API key",
            "type": "string"
          },
          "openaiModel": {
            "title": "OpenAI TTS model (advanced)",
            "type": "string",
            "placeholder": "gpt-4o-mini-tts"
          },
          "cartesiaApiKey": {
            "title": "Cartesia API key",
            "type": "string"
          },
          "cartesiaModel": {
            "title": "Cartesia model (advanced)",
            "type": "string",
            "placeholder": "sonic-3.5"
          },
          "cartesiaVoices": {
            "title": "Cartesia voices",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "gender": {
                  "type": "string"
                }
              }
            }
          },
          "clones": {
            "title": "Cloned voices (ElevenLabs)",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "webhook": {
        "title": "Webhook",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "הפעל | Enable",
            "type": "boolean",
            "default": false
          },
          "port": {
            "title": "פורט | Port",
            "type": "integer",
            "default": 8095,
            "minimum": 1024,
            "maximum": 65535
          },
          "token": {
            "title": "טוקן | Token",
            "type": "string"
          }
        }
      },
      "restoreVolume": {
        "title": "החזר ווליום קודם | Restore previous volume",
        "type": "boolean",
        "default": true
      },
      "pregenerate": {
        "title": "הכן קבצי קול מראש | Prepare audio in advance",
        "type": "boolean",
        "default": true
      },
      "cacheDays": {
        "title": "מחיקת קבצים לא בשימוש (ימים) | Delete unused audio after (days)",
        "type": "integer",
        "default": 90,
        "minimum": 1
      },
      "pythonPath": {
        "title": "נתיב Python (מתקדם) | Python path (advanced)",
        "type": "string"
      },
      "repeatGuardSeconds": {
        "title": "הגנה מהפעלה חוזרת (שניות) | Repeat guard (seconds)",
        "type": "integer",
        "minimum": 0,
        "maximum": 600,
        "default": 10,
        "description": "משפט שהופעל לא יושמע שוב במשך הזמן הזה (וגם לא בזמן שהוא מתנגן). 0 = רק בזמן שהוא מתנגן | A phrase won't replay within this time (or while still playing). 0 = only while playing"
      },
      "quietHours": {
        "title": "שעות שקט | Quiet hours",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "הפעל שעות שקט | Enable quiet hours",
            "type": "boolean",
            "default": false
          },
          "start": {
            "title": "מ-שעה | From",
            "type": "string",
            "default": "22:00",
            "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$"
          },
          "end": {
            "title": "עד שעה | Until",
            "type": "string",
            "default": "07:00",
            "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$"
          },
          "mode": {
            "title": "מה לעשות | Mode",
            "type": "string",
            "default": "lower",
            "oneOf": [
              {
                "title": "להנמיך ווליום | Lower volume",
                "enum": [
                  "lower"
                ]
              },
              {
                "title": "השתקה מלאה | Mute",
                "enum": [
                  "mute"
                ]
              }
            ]
          },
          "volume": {
            "title": "ווליום בשעות שקט | Quiet volume",
            "type": "integer",
            "default": 25,
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "chime": {
        "title": "צליל לפני הכרזה | Chime before announcements",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "השמע צליל לפני כל הכרזה | Play a chime first",
            "type": "boolean",
            "default": false
          },
          "sound": {
            "title": "צליל | Sound",
            "type": "string",
            "default": "dingdong",
            "oneOf": [
              {
                "title": "דינג-דונג | Ding-dong",
                "enum": [
                  "dingdong"
                ]
              },
              {
                "title": "רך | Soft",
                "enum": [
                  "soft"
                ]
              }
            ]
          },
          "urgentSound": {
            "title": "צליל להודעה דחופה | Urgent sound",
            "type": "string",
            "default": "urgent",
            "oneOf": [
              {
                "title": "צפצוף דחוף | Urgent beeps",
                "enum": [
                  "urgent"
                ]
              },
              {
                "title": "כמו הרגיל | Same as normal",
                "enum": [
                  "same"
                ]
              },
              {
                "title": "ללא צליל | No sound",
                "enum": [
                  "none"
                ]
              }
            ]
          }
        }
      },
      "availability": {
        "title": "חיישן זמינות הום פוד | HomePod availability sensor",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "הוסף חיישן \"מחובר\" לכל הום פוד | Add a \"connected\" sensor per HomePod",
            "type": "boolean",
            "default": false
          },
          "intervalMinutes": {
            "title": "בדיקה כל (דקות) | Check every (minutes)",
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 60
          }
        }
      }
    },
    "required": [
      "name"
    ]
  }
}
